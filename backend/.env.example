# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/docsahab?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Demo routing override (hackathon demo only — OFF by default).
# When enabled, patient DEMO_PATIENT_PHONE is always force-dispatched to
# ambulance DEMO_AMBULANCE_PHONE, bypassing nearest-ambulance matching for
# that exact pair only. Every other patient/ambulance is unaffected.
DOCSAHAB_DEMO_MODE=false
DEMO_PATIENT_PHONE=1111111111
DEMO_AMBULANCE_PHONE=2222222222
